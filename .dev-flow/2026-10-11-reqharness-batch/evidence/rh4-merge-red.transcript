            tmp_path, requester="bob", action="grant",
            person="ana", role="admin", now=T2,
        ) is None  # a second admin exists now
    
        held = propose(
            tmp_path, requester="bob", action="grant",
            person="bob", role="req-reviewer", now=T3,  # a self-change: pending
